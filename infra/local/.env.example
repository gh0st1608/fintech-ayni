# Variables del perfil "tunnel" de compose.yaml (docs/dev-environment.md). Copiar a .env (no se
# versiona). Docker Compose lo lee solo desde este directorio.

# Authtoken de tu cuenta de ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Dominio estático gratuito de tu cuenta (https://dashboard.ngrok.com/domains): la URL no cambia
# entre reinicios, así la app y el backend no se reconfiguran cada vez.
NGROK_URL=https://<tu-dominio>.ngrok-free.app
# El mismo DOCUMENTS_BUCKET del .env del backend.
DOCUMENTS_BUCKET=ayni-local-documents
