# URL del backend de Ayni, sin la ruta /admin/v1. Las variables VITE_* son públicas: nunca secretos.
VITE_API_URL=http://localhost:3000
# Cómo inicia sesión el personal: "dev" (el backend con STAFF_AUTH_PROVIDER=dev, solo local) u
# "oidc" (IAM Identity Center con MFA, COPAYNI-72). En oidc hacen falta las tres variables de abajo.
VITE_AUTH_MODE=dev
# Emisor OIDC de Identity Center: lo devuelve el stack live/prd/us-east-1/identity.
# VITE_OIDC_ISSUER=https://identitycenter.amazonaws.com/ssoins-xxxxxxxxxxxxxxxx
# ARN de la aplicación del back-office en Identity Center; es el client_id del flujo PKCE.
# VITE_OIDC_CLIENT_ID=
# Debe coincidir con la URI registrada en el grant del proveedor, o el proveedor rechaza la vuelta.
# VITE_OIDC_REDIRECT_URI=https://backoffice.solutionserj.com/auth/callback
