# URL del backend de Ayni, sin la ruta /admin/v1. Las variables VITE_* son públicas: nunca secretos.
VITE_API_URL=http://localhost:3000
# Cómo inicia sesión el personal. Por ahora solo "dev" (el backend con STAFF_AUTH_PROVIDER=dev);
# "oidc" llega con el proveedor de identidad (BO2 de docs/backoffice-plan.md en fintech-ayni).
VITE_AUTH_MODE=dev
