# Variables públicas de Expo: se incrustan en el bundle, NUNCA poner secretos aquí.
# Copiar a .env.local para desarrollo.

# dev | staging | prod
EXPO_PUBLIC_APP_ENV=dev
# URL base del backend NestJS (sin barra final)
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
# Idioma por defecto si el del dispositivo no tiene JSON (pendiente de confirmar: pending-scope M3)
EXPO_PUBLIC_DEFAULT_LANGUAGE=es
# Moneda por defecto ISO 4217 (pendiente de confirmar: pending-scope M1)
EXPO_PUBLIC_DEFAULT_CURRENCY=PEN
# Timeout de peticiones HTTP en milisegundos
EXPO_PUBLIC_HTTP_TIMEOUT_MS=15000
# API de autenticación: http (backend real) | fake (en memoria, solo dev, OTP de prueba 1234)
EXPO_PUBLIC_AUTH_API=fake
# Enlaces legales del login (https). Pendientes de definir: pending-scope L4
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
