# Copiar a .env para desarrollo local. Sin secretos reales: en los ambientes desplegados las
# variables llegan del entorno o del gestor de secretos. Ver src/config/env.validation.ts.

NODE_ENV=development
PORT=3000
APP_NAME=ayni-api
APP_VERSION=0.1.0
# debug | info | warn | error | fatal
LOG_LEVEL=info

# Seguridad HTTP
# Orígenes web separados por comas (la app mobile no usa CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8081
# true detrás de API Gateway o un balanceador.
TRUST_PROXY=false
# Milisegundos
REQUEST_TIMEOUT=30000
BODY_LIMIT=100kb
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
ENABLE_SWAGGER=true

# Moneda y montos (unidades menores de DEFAULT_CURRENCY). Valores provisionales del Figma:
# pending-scope M1, M6 y R15.
DEFAULT_CURRENCY=PEN
JOIN_PAYOUT_MIN=300000
JOIN_PAYOUT_MAX=12000000
JOIN_PAYOUT_STEP=50000
SAVING_PROGRAM_MAX=100000000
