# Copiar a .env para desarrollo local. La fuente de verdad es src/config/env.validation.ts: lo que
# no esté declarado allí, la API lo ignora; lo que falte, no arranca.
#
# Cada variable cae en una de cuatro categorías, y el comentario de cada una lo dice:
#
#   1. Local      Las que pones aquí para trabajar en tu máquina. Están descomentadas abajo.
#   2. Secreto    Nunca en el repositorio. En local, en tu .env; en los ambientes desplegados,
#                 en Secrets Manager (infra/scripts/load-app-secrets.sh las genera).
#   3. Terraform  Las inyecta el despliegue y no se ponen a mano: DB_*, las de OTP_*_CONFIGURATION_SET
#                 y las que salen de un recurso. Aquí aparecen solo para que sepas que existen.
#   4. Ajuste     Tienen valor por defecto razonable. Casi nunca se tocan; están al final del archivo.
#
# Los valores de producto (moneda, montos, duraciones) viven en infra/terraform/modules/app-config
# para los ambientes desplegados. Si cambias uno aquí, cámbialo también allí.

NODE_ENV=development
PORT=3000
APP_NAME=ayni-api
APP_VERSION=0.1.0
# debug | info | warn | error | fatal
LOG_LEVEL=info

# Seguridad HTTP
# Orígenes web separados por comas (la app mobile no usa CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# true detrás de API Gateway o un balanceador.
TRUST_PROXY=false
# Milisegundos
REQUEST_TIMEOUT=30000
BODY_LIMIT=100kb
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
# Tope propio de /admin, agregado por IP para toda la API de administración (COPAYNI-74).
ADMIN_RATE_LIMIT_TTL=60000
ADMIN_RATE_LIMIT_MAX=300
ENABLE_SWAGGER=true

# Observabilidad (README, sección Observabilidad). Sin exportar, los logs JSON van a stdout.
# local | dev | staging | prod
DEPLOYMENT_ENVIRONMENT=local
ENABLE_TRACING=false
ENABLE_METRICS=false
ENABLE_LOGGING=false
# Obligatorio si algún ENABLE_* es true. New Relic: depende de la región de la cuenta.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
# Secreto: solo en .env local o en el gestor de secretos, nunca versionado.
# NEW_RELIC_LICENSE_KEY=

# Moneda y montos (unidades menores de DEFAULT_CURRENCY). Valores provisionales del Figma:
# pending-scope M1, M6 y R15.
DEFAULT_CURRENCY=PEN
# Monedas para abrir un Game'ya (M2) y tipo de cambio fijo que actualiza el equipo (M6):
# USD:3.75 = 1 USD vale 3,75 PEN. USD se habilita cuando Mercado Pago confirme que cobra en USD.
SUPPORTED_CURRENCIES=PEN
EXCHANGE_RATES=USD:3.75
JOIN_PAYOUT_MIN=300000
# Tope de lanzamiento (P3 de pending-scope §3.2): 6.000 PEN mientras no haya mora observada ni
# VerificaID activo. Con la retención de 2 cuotas, la exposición máxima por impago es de 4.200 PEN.
# Subirlo exige KYC_PROVIDER=verificaid (lo valida env.validation.ts).
JOIN_PAYOUT_MAX=600000
JOIN_PAYOUT_STEP=50000
SAVING_PROGRAM_MAX=100000000
# Duraciones del Game'ya en turnos (Monthly Pay-in del Figma, provisional).
CIRCLE_DURATION_OPTIONS=6,10,12
# Rango de turnos, alternativa a la lista cerrada de arriba (COPAYNI-125). Van los dos o ninguno;
# con los dos puestos, el rango manda. Sin ellos se ofrece CIRCLE_DURATION_OPTIONS, que es lo que
# hay en producción: ningún rango reproduce exactamente 6,10,12, así que activarlo cambia lo que
# se le ofrece a la gente y lo decide negocio (COPAYNI-101 fija el máximo por cadencia).
# CIRCLE_TURNS_MIN=2
# CIRCLE_TURNS_MAX=24
# Qué círculo se ofrece en /circles/slots (pending-scope R2, provisional): fill_oldest | always_new
CIRCLE_ASSIGNMENT_STRATEGY=fill_oldest
# Cadencias que se pueden crear (COPAYNI-121): monthly | biweekly | weekly. monthly es obligatoria.
# Habilitar otra exige antes COPAYNI-116 y sus parámetros de morosidad (COPAYNI-111).
CIRCLE_CADENCES_ENABLED=monthly
# Gracia y mora de las cadencias no mensuales (COPAYNI-111), p. ej. weekly:1,biweekly:2 y
# weekly:150. Las de la mensual son DELINQUENCY_GRACE_DAYS y LATE_FEE_BPS. Una cadencia habilitada
# sin las suyas no arranca: los valores mensuales están calibrados para un ciclo de 30 días.
DELINQUENCY_GRACE_DAYS_BY_CADENCE=
LATE_FEE_BPS_BY_CADENCE=
CIRCLE_START_OFFSET_MONTHS=1
RECOMMENDED_CIRCLES_LIMIT=5
# Ciclo mensual (COPAYNI-56): vencimiento de las cuotas (R19, provisional) y pagos simulados
CIRCLE_INSTALLMENT_DUE_DAY=1
# Impago (COPAYNI-57): gracia en días corridos, cargo por mora y penalidad de devolución (bps)
DELINQUENCY_GRACE_DAYS=3
LATE_FEE_BPS=300
EXPULSION_REFUND_PENALTY_BPS=500
# Fondo de garantía (COPAYNI-58): parte de las Admin Fees y saldo mínimo en cuotas base por círculo
# 50 % desde P2 de pending-scope §3.2 (antes 25 %); rango de operación sugerido 3000–5000 bps.
GUARANTEE_FUND_FEE_SHARE_BPS=5000
GUARANTEE_FUND_MIN_INSTALLMENTS_PER_CIRCLE=2
# Regla de confianza y retención del payout (COPAYNI-60, valores propuestos de R18)
# 0 al lanzar (P10 de pending-scope §3.2): nadie tiene círculos completados todavía, así que exigir
# 1 dejaría los turnos Fastest Payout vacíos y todos los círculos arrancarían incompletos. El riesgo
# lo compensa el tope bajo de JOIN_PAYOUT_MAX. Subir a 1 cuando haya círculos terminados.
TRUST_FASTEST_MIN_COMPLETED_CIRCLES=0
# Retención del payout (COPAYNI-60 y 112): días de cobertura, no número de cuotas. 60 días son
# las 2 cuotas que se retenían antes en una junta mensual. El tope sobre el pozo en bps;
# 10000 es sin tope, el comportamiento actual.
PAYOUT_RETENTION_COVERAGE_DAYS=60
PAYOUT_RETENTION_MAX_POT_BPS=10000
# Firma del contrato y del pagaré (COPAYNI-89): horas para firmar antes de liberar el turno.
AGREEMENT_SIGNATURE_TTL_HOURS=48
# API de administración (COPAYNI-61): antigüedad máxima de la autenticación del personal (step-up)
STAFF_STEP_UP_MAX_AGE_SECONDS=300
# Horas que vive una propuesta de doble aprobación sin decidir (COPAYNI-73).
STAFF_APPROVAL_TTL_HOURS=72
# Días antes del vencimiento de una cuota en que se notifica, además del mismo día (COPAYNI-84).
NOTIFICATION_DUE_SOON_DAYS=3
# Antelación del recordatorio por cadencia, como cadencia:dias (COPAYNI-120). Sin entrada rige el
# valor de arriba, calibrado para un ciclo de 30 días; con 0 no se manda recordatorio previo y
# queda solo el del día del vencimiento. Tiene que ser menor que el ciclo o la API no arranca.
# NOTIFICATION_DUE_SOON_DAYS_BY_CADENCE=biweekly:2,weekly:1
# WhatsApp de soporte para la Ayuda (COPAYNI-83): solo dígitos con código de país.
# SUPPORT_WHATSAPP_NUMBER=
# Identidad del personal del back-office: unconfigured | oidc | dev (dev, solo en local).
STAFF_AUTH_PROVIDER=dev
# Con oidc: emisor y audiencia (el client id o ARN de la aplicación del back-office). El adaptador
# es de OIDC estándar: valida firma, emisor, audiencia y vigencia contra el JWKS del proveedor.
# BO2 elige IAM Identity Center, pero su parte OIDC está sin verificar (ver docs/backoffice-plan.md):
# su API declara el id_token como no soportado, así que hay que comprobar contra el tenant real el
# documento de descubrimiento, el formato del token y el claim de los grupos antes de ponerlo.
# STAFF_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
# STAFF_OIDC_AUDIENCE=<client-id>
# Solo si el proveedor no publica las claves en <emisor>/.well-known/jwks.json.
# STAFF_OIDC_JWKS_URL=
# Claim con los grupos de la persona; en Cognito, cognito:groups.
# STAFF_OIDC_ROLES_CLAIM=cognito:groups
# Cuando los grupos no se llaman igual que los roles hay que traducirlos. Sin este mapa, los
# valores del claim se tratan como roles tal cual.
# STAFF_OIDC_GROUPS_MAP={"ayni-prd-administradores":["super_admin"],"ayni-prd-soporte":["support"],"ayni-prd-facturadores":["finance"]}
# Pasarela de pago (COPAYNI-34): fake en desarrollo; mercadopago exige el access token y la
# clave de webhooks (secretos: nunca en el repositorio). Yape usa Checkout API con Orders; la public
# key solo la usa la app para generar el token de Yape.
PAYMENT_GATEWAY=fake
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
# Login social (COPAYNI-91, docs/api/social-auth.md). Una lista vacia apaga ese proveedor y su
# endpoint responde 503: se puede desplegar sin cuentas de Google ni de Apple.
# Client id de Google separados por coma (audiencias admitidas del ID Token); son publicos.
# GOOGLE_CLIENT_IDS=
# Cliente Web: el unico tipo al que Google admite un redirect_uri HTTPS propio, que es lo que
# exige el flujo que coordina el backend. Debe estar tambien en GOOGLE_CLIENT_IDS.
# GOOGLE_WEB_CLIENT_ID=
# Client secret de ese cliente Web. ES UN SECRETO: Secrets Manager, nunca el repositorio.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.ayni.pe/v1/auth/social/google/callback
# Audiencias de Apple: bundle id de iOS y Services ID del flujo web de Android.
# APPLE_CLIENT_IDS=
# APPLE_SERVICE_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# Clave .p8 de Sign in with Apple, en PEM. ES UN SECRETO: Secrets Manager, nunca el repositorio.
# APPLE_PRIVATE_KEY=
# APPLE_REDIRECT_URI=https://api.ayni.pe/v1/auth/social/apple/callback
# Deep link por el que la app recibe el codigo interno de un solo uso.
SOCIAL_APP_REDIRECT_URI=ayni://auth/social
# SOCIAL_FLOW_TTL_SECONDS=600

# Aviso en el celular (COPAYNI-85): fake solo registra el envío y está prohibido en production;
# expo envía por Expo Push Service. El token de acceso solo hace falta si el proyecto de Expo activa
# la seguridad reforzada de notificaciones (es un secreto).
PUSH_PROVIDER=fake
# EXPO_ACCESS_TOKEN=
# EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
# PUSH_TIMEOUT_MS=10000
# Horas tras las que un aviso ya no se envía; la notificación se queda en la bandeja igual.
# PUSH_MAX_AGE_HOURS=12
# PUSH_BATCH_SIZE=200
# Tandas por corrida: la corrida vacía la cola en vez de dejar el excedente para mañana, que
# para entonces ya habría pasado PUSH_MAX_AGE_HOURS y se descartaría sin enviarse.
# PUSH_MAX_BATCHES=50
# PUSH_MAX_ATTEMPTS=3
# Referidos (COPAYNI-51 a 53; R7 provisional)
REFERRAL_REWARD_AMOUNT=15000
REFERRAL_MAX_REWARDED_INVITES=10
REFERRAL_LINK_BASE_URL=ayni://invite
# Programa de ahorro (COPAYNI-32 y 33; R6 provisional)
SAVING_PLANS=lite:300000,bronze:600000,silver:1200000,gold:3000000,platinum:6000000,diamond:10000000
SAVING_CASHBACK_BPS=6:500,12:1000,24:2000
# KYC (COPAYNI-42 a 49): simulated o manual; simulated está prohibido en production
# Documentos en S3 de floci (docker compose -f ../../infra/local/compose.yaml up -d y crear el
# bucket); simulated no guarda archivos. Con floci, credenciales ficticias: sin ellas el SDK usaría
# el AWS_PROFILE de la máquina.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
DOCUMENT_STORAGE=simulated
# DOCUMENTS_BUCKET=ayni-local-documents
# DOCUMENTS_S3_ENDPOINT=http://127.0.0.1:4566
# Con la app en un teléfono (docs/dev-environment.md): la URL pública de ngrok.
# DOCUMENTS_S3_PUBLIC_ENDPOINT=https://<tu-dominio>.ngrok-free.app
AWS_REGION=us-east-1
KYC_PROVIDER=simulated
KYC_SIMULATED_RESULT=approved
# Verificación de identidad con VerificaID (COPAYNI-42): KYC_PROVIDER=verificaid exige el token de
# la API (prod-hub.verifica.id) y el del webhook (32+ caracteres). Son secretos: nunca en el repo.
# VERIFICAID_API_URL=https://sandbox-api.verifica.id
# VERIFICAID_API_TOKEN=
# VERIFICAID_WEBHOOK_TOKEN=
# VERIFICAID_CALLBACK_URL=ayni://identity-verification
IDENTITY_CONSENT_VERSION=2026-11
IDENTITY_MAX_REJECTED_ATTEMPTS=3
IDENTITY_SESSION_TTL_HOURS=24
DOCUMENT_UPLOAD_URL_TTL_SECONDS=300
PAYIN_LIMIT_INCOME_SHARE_BPS=3000
CIRCLE_PAYMENTS_ADAPTER=fake
# Días para aprobar el inicio de un círculo incompleto (COPAYNI-62, supuesto de R2)
CIRCLE_START_APPROVAL_DAYS=7
# Versión vigente de los términos del círculo (COPAYNI-86): subirla al cambiar el texto
CIRCLE_TERMS_VERSION=2026-11
BUSINESS_TIME_ZONE=America/Lima
# Passcode de acceso (COPAYNI-23, supuesto de D9)
PASSCODE_MAX_ATTEMPTS=5
PASSCODE_LOCK_SECONDS=900
# Precio de los slots en puntos básicos (R1 y R4, provisionales)
SLOT_FASTEST_SHARE_BPS=2500
SLOT_HIGHEST_SHARE_BPS=2500
SLOT_MAX_FEE_BPS=1000
SLOT_MAX_DISCOUNT_BPS=500
ADMIN_FEE_BPS=1200
ADMIN_FEE_MODE=added_to_installments

# PostgreSQL (npm run db:up levanta uno local con estas credenciales, solo de desarrollo).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ayni
DB_USERNAME=ayni
# Secreto en los ambientes desplegados: llega de Secrets Manager.
DB_PASSWORD=ayni
# true contra RDS (rds.force_ssl). DB_SSL_CA: bundle de CA de RDS en PEM; DB_SSL_CA_FILE, su
# ruta (la imagen trae /app/certs/rds-ca.pem). Sin ninguno, se usan las CA del sistema, que no
# incluyen la raíz de Amazon RDS.
DB_SSL=false
# DB_SSL_CA_FILE=/app/certs/rds-ca.pem
DB_POOL_MAX=10

# Usuario con el que la API se conecta en los ambientes desplegados. Solo lo usa el runner de
# migraciones (npm run migrate), que lo crea o actualiza con la credencial maestra y le da
# permisos de datos sin DDL. En local no hace falta: se migra con el mismo usuario que la API.
# DB_APP_USERNAME=ayni_app
# DB_APP_PASSWORD=

# Autenticación (README, sección Autenticación). Sin JWT_PRIVATE_KEY ni OTP_PEPPER, se generan
# efímeros al arrancar (solo fuera de production).
# JWT_PRIVATE_KEY=
# OTP_PEPPER=
# Clave AES-256 (32 bytes en base64) para cifrar datos guardados, como el CCI de la cuenta de cobro
# (COPAYNI-81). Obligatoria en production; sin valor, se usa una clave fija de desarrollo.
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY=
# Código fijo de desarrollo: no se envía nada. Prohibido en production y con OTP_DELIVERY=aws.
OTP_DEV_CODE=1234
# Envío real (pending-scope T6). Para probar el email con floci: quitar OTP_DEV_CODE y descomentar;
# los emails quedan en http://localhost:4566/_aws/ses. floci no emula el SMS.
# OTP_DELIVERY=aws
# OTP_EMAIL_FROM=Ayni <no-reply@ayni.test>
# OTP_SES_ENDPOINT=http://localhost:4566
# OTP_SMS_ORIGINATION_IDENTITY=

# Métodos de cobro en Perú (COPAYNI-95): cuenta bancaria y Yape/Plin
PAYOUT_METHODS=bank_account,wallet
PAYOUT_METHODS_UNAVAILABLE=
PAYOUT_METHODS_NO_CHARGE=bank_account,wallet

# Elegibilidad para unirse a un círculo (COPAYNI-31, provisionales hasta el KYC y R5).
# assume_unverified simula usuarios sin National ID. 0 = sin límite mensual de pay-in.
JOIN_IDENTITY_CHECK=assume_verified
JOIN_MONTHLY_PAYIN_LIMIT=0

# ------------------------------------------------------------------------------------------------
# 4. Ajustes con valor por defecto
#
# No hace falta ponerlos: la API usa estos valores si no existen. Se listan porque están validados
# y porque conviene saber qué se puede mover sin tocar código.
# ------------------------------------------------------------------------------------------------

# Sesión (COPAYNI-19 y 20). El access token es corto a propósito; el refresh rota en cada uso.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Identifican quién emitió el token y para quién vale; los comprueba el verificador.
# JWT_ISSUER=ayni-api
# JWT_AUDIENCE=ayni-mobile
# Identificador de la clave en el JWKS; cambiarlo permite rotar sin invalidar lo ya emitido.
# JWT_KEY_ID=ayni-1

# Política del código de verificación (COPAYNI-19).
# OTP_CODE_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_RESENDS=3
# Tope de inicios por identificador dentro de la ventana; los siguientes responden 429.
# OTP_START_MAX_PER_WINDOW=5
# OTP_START_WINDOW_SECONDS=900

# Tiempos de espera de terceros, en milisegundos.
# SOCIAL_TIMEOUT_MS=10000
# MERCADOPAGO_TIMEOUT_MS=10000
# VERIFICAID_TIMEOUT_MS=10000
# MERCADOPAGO_API_URL=https://api.mercadopago.com

# 3. Terraform. En los ambientes desplegados las inyecta el módulo otp-messaging; en local no
# aplican. Aparecen aquí para que no sorprendan al leer la definición de la tarea.
# OTP_SES_CONFIGURATION_SET=
# OTP_SMS_CONFIGURATION_SET=
# 3. Terraform. Certificado de la CA de RDS en PEM. El despliegue usa DB_SSL_CA_FILE con el
# bundle que la imagen trae en /app/certs/rds-ca.pem; esta variable es la alternativa en línea.
# DB_SSL_CA=
