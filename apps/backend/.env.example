# Copiar a .env para desarrollo local. Sin secretos reales: en los ambientes desplegados las
# variables llegan del entorno o del gestor de secretos. Ver src/config/env.validation.ts.

NODE_ENV=development
PORT=3000
APP_NAME=ayni-api
APP_VERSION=0.1.0
# debug | info | warn | error | fatal
LOG_LEVEL=info

# Seguridad HTTP
# Orígenes web separados por comas (la app mobile no usa CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8081
# true detrás de API Gateway o un balanceador.
TRUST_PROXY=false
# Milisegundos
REQUEST_TIMEOUT=30000
BODY_LIMIT=100kb
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
ENABLE_SWAGGER=true

# Observabilidad (README, sección Observabilidad). Sin exportar, los logs JSON van a stdout.
# local | dev | staging | prod
DEPLOYMENT_ENVIRONMENT=local
ENABLE_TRACING=false
ENABLE_METRICS=false
ENABLE_LOGGING=false
# Obligatorio si algún ENABLE_* es true. New Relic: depende de la región de la cuenta.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
# Secreto: solo en .env local o en el gestor de secretos, nunca versionado.
# NEW_RELIC_LICENSE_KEY=

# Moneda y montos (unidades menores de DEFAULT_CURRENCY). Valores provisionales del Figma:
# pending-scope M1, M6 y R15.
DEFAULT_CURRENCY=PEN
JOIN_PAYOUT_MIN=300000
JOIN_PAYOUT_MAX=12000000
JOIN_PAYOUT_STEP=50000
SAVING_PROGRAM_MAX=100000000
# Duraciones del Game'ya en meses (Monthly Pay-in del Figma, provisional).
CIRCLE_DURATION_OPTIONS=6,10,12
# Qué círculo se ofrece en /circles/slots (pending-scope R2, provisional): fill_oldest | always_new
CIRCLE_ASSIGNMENT_STRATEGY=fill_oldest
CIRCLE_START_OFFSET_MONTHS=1
BUSINESS_TIME_ZONE=America/Lima
# Precio de los slots en puntos básicos (R1 y R4, provisionales)
SLOT_FASTEST_SHARE_BPS=2500
SLOT_HIGHEST_SHARE_BPS=2500
SLOT_MAX_FEE_BPS=1000
SLOT_MAX_DISCOUNT_BPS=500
ADMIN_FEE_BPS=1200
ADMIN_FEE_MODE=added_to_installments

# PostgreSQL (npm run db:up levanta uno local con estas credenciales, solo de desarrollo).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ayni
DB_USERNAME=ayni
# Secreto en los ambientes desplegados: llega de Secrets Manager.
DB_PASSWORD=ayni
# true contra RDS (rds.force_ssl). DB_SSL_CA: bundle de CA de RDS en PEM.
DB_SSL=false
DB_POOL_MAX=10

# Autenticación (README, sección Autenticación). Sin JWT_PRIVATE_KEY ni OTP_PEPPER, se generan
# efímeros al arrancar (solo fuera de production).
# JWT_PRIVATE_KEY=
# OTP_PEPPER=
# Sin proveedor de SMS/email todavía: código fijo de desarrollo. Prohibido en production.
OTP_DEV_CODE=1234
